<?xml version="1.0" encoding="utf-8"?>
<!-- 原生壳面语义色 token（浅色）。与 values-night/ds_colors.xml 成对。
     ✅ 已被 Kotlin 消费（2026-10-15 复核）：`MainActivity.kt`（本层 override）用
     `R.color.ds_ok`（状态点）、`R.color.ds_bg`（壳面底色）、`R.color.ds_accent`
     （链接/强调，3 处）；深色模式经 `values-night/` 同名 token 跟随系统。
     ⚠️ 仍有 3 处 `Color.WHITE` / `Color.DKGRAY` / `Color.GRAY` 直接字面量
     （白底按钮与次要文字），未接成语义色 —— 它们是与 Web UI 深浅色一致性的剩余缺口。
     新增独立文件而非改 colors.xml，是为了不触碰上游文件、零 override 漂移。 -->
<resources>
  <!-- 底与面 -->
  <color name="ds_bg">#F8FAFC</color>
  <color name="ds_surface">#FFFFFF</color>
  <color name="ds_border">#E2E8F0</color>

  <!-- 文字 -->
  <color name="ds_text_primary">#0F172A</color>
  <color name="ds_text_secondary">#475569</color>

  <!-- 语义信号 -->
  <color name="ds_accent">#2563EB</color>
  <color name="ds_ok">#16A34A</color>
  <color name="ds_warn">#D97706</color>
  <color name="ds_danger">#DC2626</color>
</resources>
