<?xml version="1.0" encoding="utf-8"?>
<!-- 原生壳面语义色 token（深色）。与 values/ds_colors.xml 成对，同名同义。
     深色下提高前景亮度、压低背景，保证与 Web UI 深色主题观感一致；
     状态点/链接色同步提亮，避免深底上对比度不足。 -->
<resources>
  <color name="ds_bg">#0B0F14</color>
  <color name="ds_surface">#1C1C1E</color>
  <color name="ds_border">#2A3441</color>

  <color name="ds_text_primary">#F1F5F9</color>
  <color name="ds_text_secondary">#94A3B8</color>

  <color name="ds_accent">#60A5FA</color>
  <color name="ds_ok">#4ADE80</color>
  <color name="ds_warn">#FBBF24</color>
  <color name="ds_danger">#F87171</color>
</resources>
